# ============================================================
# 简报台 - 环境配置模板
#
# 使用方式：
#   1. 复制本文件为 .env（cp .env.example .env）
#   2. 编辑 .env，填入必填项（AI_API_KEY；消息源为 weflow 时另需 WEFLOW_API_TOKEN）
#   3. 其余配置保持默认即可，按需修改
# ============================================================

# ---------------- 消息源 / 插件 ----------------

# 消息源为内置插件（weflow / qqflow），启用完全走插件开关：
# PLUGINS=["*"] 启用全部已发现插件（默认）；只启用 weflow：PLUGINS=["weflow"]；
# 或 PLUGINS_DISABLED=["qqflow"]
PLUGINS=["*"]

# 明确禁用的插件名列表（JSON 数组，优先于 PLUGINS）
PLUGINS_DISABLED=[]

# 必选插件名列表（JSON 数组）：其装配失败视为致命（启动中止），其余插件失败仅禁用
PLUGINS_REQUIRED=[]

# 开发期插件目录：目录下每个 *.py 文件暴露 `plugin` 实例即被加载（免打包）；留空不扫描
PLUGIN_PATH=

# ---------------- WeFlow 消息源专属配置（weflow 插件启用时使用） ----------------

# WeFlow HTTP API 访问令牌（必填）
WEFLOW_API_TOKEN=

# WeFlow API 地址（默认本机 5031 端口）
WEFLOW_API_BASE=http://127.0.0.1:5031

# SSE 实时重连退避（毫秒，weflow 专属）：最小 / 最大重连间隔
WEFLOW_SSE_RECONNECT_INITIAL_MS=1000
WEFLOW_SSE_RECONNECT_MAX_MS=60000

# ---------------- qqflow 消息源专属配置（qqflow 插件启用时 API_TOKEN/QQ/KEY 必填；缺失任一 → 插件自禁用） ----------------

# qqflow-server API 地址（默认本机 5032 端口）
QQFLOW_API_BASE=http://127.0.0.1:5032

# qqflow-server 访问令牌（必填）：服务首次启动自动生成并持久化，
# Windows: %LOCALAPPDATA%\qqflow-server\token.txt
QQFLOW_API_TOKEN=

# 引导注册 QQ 号（必填）：服务端无就绪账号时自动 POST /api/v1/accounts 注册
QQFLOW_QQ=

# 引导注册密钥（必填，16 字节可打印 ASCII）
QQFLOW_KEY=

# QQ 消息数据库路径（可选，允许为空）：留空时由 qqflow-server 自动回退
# 平台默认位置（Windows: Documents\Tencent Files；Linux: ~/.config/QQ；
# macOS: ~/Library/Application Support/QQ）
QQFLOW_DB_PATH=

# SSE 实时重连退避（毫秒，qqflow 专属）：最小 / 最大重连间隔
QQFLOW_SSE_RECONNECT_INITIAL_MS=1000
QQFLOW_SSE_RECONNECT_MAX_MS=60000

# ---------------- AI 服务（必填） ----------------

# AI API Key（必填）
AI_API_KEY=

# AI API 地址（OpenAI 兼容接口）
AI_API_BASE=https://api.deepseek.com

# AI 模型名称
AI_MODEL=deepseek-v4-flash

# 单次 AI 分类输出的最大 token 数（上限 8192，为 DeepSeek 最大输出）
# 输出触顶会被截断，可能导致 AI 返回的 JSON 不完整
MAX_CLASSIFY_TOKENS=8192

# AI 请求最大并发数（分类与去重共用）；0 = 不限制
# 本地模型（如 Ollama）建议设为 1
AI_MAX_CONCURRENCY=0

# 是否禁用模型思考模式（如 Qwen3/Qwen3.5 的 thinking）
# 设为 true 时，AI 请求会附加 reasoning_effort="none"；留空或 false 则不传该参数
AI_DISABLE_THINKING=false

# ---------------- 消息同步 ----------------

# 历史回填（REST）：增量轮询按会话独立推进水位——
# 会话启用/从未轮询时按"最近 BACKFILL_HOURS 小时"回填一次，之后只拉增量；
# 停用会话不参与轮询（重新启用即再次回填）
# ⚠️ 警告：设为 -1 表示拉取全部历史——每次同步都会全量扫描，
# 消息量大时非常耗时且 AI 调用量激增；建议首次全量拉取完成后改回正常值（如 24）
BACKFILL_HOURS=24

# 增量轮询窗口与会话水位的重叠秒数：吸收边界秒、时钟偏差与翻页期间的
# 上游插入偏移；重叠部分由已处理表去重，无 AI 开销。调大可提高容错、
# 调小可减少重复拉取（0 = 严格从水位开始）
POLL_OVERLAP_SECONDS=300

# 已忽略条目过期时间（小时）：每次启动时清理「被忽略超过该时长」的条目
# （items 与 raw_messages 中删除，processed_messages 保留）；0 = 禁用清理
IGNORED_EXPIRY_HOURS=0

# 过滤本账号自己发送的消息（所有消息入口：SSE 实时 + REST 回填）
# weflow REST 按 isSend 判定、其 SSE 上游已不推送自消息；
# qqflow REST 按自身 UID（u_<QQFLOW_QQ>）判定，SSE 事件无发送者标识、开启后按消息回查 REST
IGNORE_SELF=true

# 实时批缓冲（跨源公共）：实时监听攒够多少条消息触发处理（越小实时性越高），
# 或等待多久（毫秒）后强制触发
REALTIME_BATCH_MAX_COUNT=1
REALTIME_BATCH_TIMEOUT_MS=180000

# 回填批量：历史回填时单次 AI 分类合并的消息条数（调大省 token，不影响 SSE 实时性）
BACKFILL_BATCH_MAX_COUNT=20

# ── 省 token 配置组合（按量计费用户建议）──────────────────────────
# 实时批攒到 10 条才触发 AI（实时性略降但调用量大幅下降），回填批 20，
# 并开启嵌入向量去重（EMBED_API_BASE 填嵌入服务地址）让字符重叠预筛更精准：
#   REALTIME_BATCH_MAX_COUNT=10
#   REALTIME_BATCH_TIMEOUT_MS=60000
#   BACKFILL_BATCH_MAX_COUNT=20
#   EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBED_MODEL=qwen3.7-text-embedding
# 注意：批大小与实时性成正比，群消息吞吐高的场景可调小。
# ─────────────────────────────────────────────────────────────────

# ---------------- 去重 ----------------

# 去重预过滤阈值：标题字符重叠达到该比例才进入 AI 语义判重（调高更严格、更省 AI 调用）
# 嵌入向量去重禁用时为主通道；嵌入模式下余弦零候选时作兜底通道
DEDUP_SIMILARITY_THRESHOLD=0.3

# 嵌入向量去重（可选）：EMBED_API_BASE 留空则完全禁用，回退到上方字符重叠预过滤（默认行为）
# 推荐使用 qwen3.7-text-embedding 模型，在阿里云百炼中获取
EMBED_API_BASE=
# 嵌入模型；留空时复用 AI_MODEL（仅 EMBED_API_BASE 配置后生效）
EMBED_MODEL=
# 嵌入 API Key；留空时复用 AI_API_KEY
EMBED_API_KEY=
# 历史缓存首次加载时的批量嵌入大小（阿里云百炼上限 20；OpenAI 等上限更高可调大）
EMBED_BATCH_SIZE=20
# 余弦相似度预过滤阈值（>= 该值才进入 AI 判重；实验：易混样本 0.79-0.89、同事件最低 0.87，
# 0.80 可在不漏同事件的前提下减少易混候选进 LLM）
DEDUP_EMBED_THRESHOLD=0.80
# 相似度最高的候选条数（按序交给 AI 判重的上限）
DEDUP_EMBED_TOP_K=3
# 低置信复核阈值：余弦候选相似度落在 [该值, DEDUP_EMBED_THRESHOLD) 区间且无正常候选
# （>= DEDUP_EMBED_THRESHOLD）时，全部候选经 AI 一致判 SAME 才判重——修复中段
# 相似度真实重复被门禁静默漏判（如两条招新文案余弦 0.75 < 0.80）
DEDUP_EMBED_FALLBACK_THRESHOLD=0.65
# 同文本短路阈值：候选相似度 >= 该值视为同文本，AI 判 SAME 即直接判重、不参与
# 多数票（防被高相似但不同话题的干扰候选稀释成平票而漏判）
DEDUP_STRONG_THRESHOLD=0.99

# ---------------- 会话内同话题片段合并 ----------------

# 同一会话里前后多条消息常是同一个话题的片段（物品名/价格/运费各一句），
# 逐条分类会各成一张卡。开启后：新卡与「同会话同类别、消息时间相差不超过
# MERGE_WINDOW_MINUTES 分钟」的未核实卡片经 AI 判官判定，同一话题则折进
# 最早那张头卡（标题保留头句，关键信息/原文引用合并，晚卡删除）。
# 与去重互补：去重回答「是否同一件事→丢弃」，合并回答「是否同话题片段→折叠」。
# 0 = 禁用合并
MERGE_WINDOW_MINUTES=10
# 每张新卡最多交给判官判定的候选头卡数（超出窗口/类别/会话的候选不进判定）
MERGE_MAX_CANDIDATES=3

# ---------------- 日志 ----------------

# 日志级别：INFO（默认，阶段/汇总）/ DEBUG（逐条细节：事件、请求、过滤决策）
LOG_LEVEL=INFO

# ---------------- 服务 ----------------

# 数据库文件路径（SQLite）
DB_PATH=briefdesk.sqlite

# Web 服务端口
SERVER_PORT=3000
