{
  "feature": "dedup",
  "description": "示例：语义去重基准（全部虚构数据）。items 为去重缓存中的历史卡片，query 为新消息。",
  "cases": [
    {
      "id": "dd-001",
      "note": "措辞不同但实质相同 → 同一件事（same=true）",
      "items": [
        {
          "msg_id": "i1",
          "content": "摄影社招新面试，周三下午3点，体育馆",
          "sender_name": "李娜",
          "sender_id": "u1",
          "session_id": "s1",
          "group_name": "社团招新群",
          "timestamp": "2026-04-01 10:00",
          "source": "bench",
          "title": "摄影社招新面试"
        }
      ],
      "query": {
        "msg_id": "q1",
        "content": "摄影社周三下午三点在体育馆招新",
        "sender_name": "刘洋",
        "sender_id": "u2",
        "session_id": "s1",
        "group_name": "社团招新群",
        "timestamp": "2026-04-02 09:30",
        "source": "bench",
        "title": "摄影社周三下午三点在体育馆招新"
      },
      "expected": {"same": true}
    },
    {
