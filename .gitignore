.visual-baseline/
.visual-current/
.visual-diff/
.visual-tmp/

# Agent tooling state（本地会话状态，禁止入库）
.agent-teams/
.tmp-edge/

# Virtual environment
.venv/
venv/

# Dependencies
*.egg-info/
dist/

# Database
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Environment secrets
.env
.env.*.local

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

